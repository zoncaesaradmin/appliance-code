# Copy this file to dev-container/env and edit as needed. This is a
# Makefile fragment (not a shell .env file) that the top-level Makefile
# `-include`s, so every developer can override the dev-container image,
# engine, or cache locations without touching the Makefile or exporting
# env vars by hand. `dev-container/env` itself is gitignored; only this
# example is tracked. Uncomment and edit only the lines you want to
# override; use `VAR = value`, not `VAR ?= value`.

# Container engine binary. Podman is the default; set to "docker" if
# that's what's actually installed.
# CONTAINER_ENGINE = podman

# The Makefile already defaults SUDO to "sudo -n" (non-interactive), since
# `make -C services/controlplane image` needs the outer dev-shell container to
# be rootful: a rootless outer container only gets one, fully consumed
# user-namespace mapping, so a nested Buildah build inside it can't
# create the additional mapping a real image layer needs. This requires
# a one-time host setup — see docs/dev-container.md for the full
# walkthrough, summarized here:
#   1. sudo visudo -f /etc/sudoers.d/appliance-podman-nopasswd
#      add: <user> ALL=(root) NOPASSWD: /usr/bin/podman   (use `command -v podman` for the exact path)
#   2. export DEV_REGISTRY_USER=<github-username>
#      export DEV_REGISTRY_TOKEN=<PAT with read:packages>
#      make dev-registry-login
#      (persistent user-owned auth file reused by rootful podman via
#      `podman run --authfile`)
#
# Only uncomment the line below to turn SUDO *off* — e.g. this host is
# already rootful, or you only use dev-shell/dev-run for plain
# interactive debugging and haven't set up the sudoers rule above.
# SUDO =

# Dev-container image. Prefer host + optional repo + name + tag (release
# skill / LAN registry). Legacy: put host/repo in DEV_REGISTRY and leave
# DEV_IMAGE_REPO empty.
# DEV_REGISTRY     = artifact-dns-1.appliance.internal
# DEV_IMAGE_REPO   = development-container
# DEV_IMAGE_NAME   = dev-build
# DEV_IMAGE_TAG    = latest
# DEV_REGISTRY_TLS_VERIFY = false
#
# Or GHCR-style (legacy combined registry path):
# DEV_REGISTRY   = ghcr.io/zoncaesaradmin/development-container
# DEV_IMAGE_NAME = dev-build
# DEV_IMAGE_TAG  = latest

# Or set the full reference directly, bypassing the composed variables above.
# DEV_IMAGE = ghcr.io/zoncaesaradmin/development-container/dev-build:v0.1.0

# Auth file rootful podman should use when pulling the shared
# dev-container image. Populate it once with:
#   export DEV_REGISTRY_USER=<github-username>
#   export DEV_REGISTRY_TOKEN=<PAT with read:packages>
#   make dev-registry-login
# Leave this default unless you intentionally keep credentials elsewhere.
# DEV_REGISTRY_AUTH_FILE = $(HOME)/.config/containers/auth.json

# Host directory that persists Go build/module caches and nested
# containers-storage (Buildah/Podman/Skopeo graphroot) across
# `make dev-shell`/`make dev-run` invocations. Each invocation is
# otherwise a fresh, throwaway container; without these mounts, large
# nested image builds fill the outer container writable layer.
# DEV_CACHE_DIR = $(HOME)/.cache/appliance-code-dev

# Nested containers-storage driver used inside the outer container.
# Default is overlay (DEV_RUN always passes --privileged --device /dev/fuse).
# Set to vfs only if overlay fails on a given host. Host cache paths are
# driver-specific under DEV_CACHE_DIR/containers/<driver>/ so layouts
# never mix.
# DEV_STORAGE_DRIVER = overlay

# Bind-mount options appended to every -v flag. Leave empty on Linux/macOS
# without SELinux. On SELinux-enforcing hosts (Fedora, RHEL, CentOS),
# set this to ":Z" so Podman relabels the mounted directories for
# container access.
# DEV_VOLUME_OPTS = :Z

# syntax=docker/dockerfile:1.7
ARG GO_IMAGE=docker.io/library/golang:1.26
ARG RUNTIME_IMAGE=alpine:3.24.1
ARG RUNTIME_PREBAKED=0
ARG BUILDPLATFORM
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG BUILD_VERSION=development
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
RUN test -n "${TARGETARCH}" && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -mod=vendor -trimpath -ldflags="-s -w -X main.buildVersion=${BUILD_VERSION}" -o /out/channel-integration ./cmd/channel-integration

FROM ${RUNTIME_IMAGE}
ARG RUNTIME_PREBAKED
RUN set -eux; if [ "${RUNTIME_PREBAKED}" != "1" ]; then apk add --no-cache ca-certificates tzdata; fi; addgroup -S -g 10013 channel-integration; adduser -S -D -H -u 10013 -G channel-integration channel-integration
COPY --from=build /out/channel-integration /channel-integration
USER 10013:10013
EXPOSE 8080
ENTRYPOINT ["/channel-integration"]

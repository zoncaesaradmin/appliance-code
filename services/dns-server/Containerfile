ARG BASE_IMAGE=registry.k8s.io/coredns/coredns:v1.14.4
ARG RUNTIME_IMAGE=alpine:3.24.1
ARG RUNTIME_PREBAKED=0

FROM ${BASE_IMAGE} AS upstream

# Alpine wrapper adds bash+tee so we can mirror DNS server (CoreDNS) stdout/stderr
# into /data/zon/logs/dns (upstream distroless image has no shell).
#
# Port 53 bind for UID 10004 is provided by zonctl hostdns.Prepare, which
# sets net.ipv4.ip_unprivileged_port_start=0 on the node. Do not wrap PID 1
# with capsh --addamb: under drop=ALL + NET_BIND_SERVICE only, capsh cannot
# mutate the inheritable set (needs SETPCAP) and fails with
# "Unable to set inheritable capabilities: Operation not permitted".
FROM ${RUNTIME_IMAGE}
ARG RUNTIME_PREBAKED

RUN set -eux; \
    if [ "${RUNTIME_PREBAKED}" != "1" ]; then \
      apk add --no-cache bash ca-certificates; \
    fi

COPY --from=upstream /coredns /coredns
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod 0755 /coredns /usr/local/bin/entrypoint.sh

# Matches appliance-dns chart podSecurityContext runAsUser/runAsGroup.
USER 10004:10004

# Chart args (for example -conf /etc/coredns/Corefile) are appended after
# the entrypoint.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

{
  "name": "appliance-controlplane-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/vite-dev.mjs",
    "dev:mock": "MODE=mock node ./scripts/vite-dev.mjs",
    "build": "tsc --noEmit && node ./scripts/vite-build.mjs",
    "preview": "node ./scripts/vite-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test:ui": "vitest run --environment jsdom",
    "openapi:types": "openapi-typescript ../../docs/openapi/control-plane-v1.yaml -o src/openapi-types.ts",
    "openapi:check": "node ./scripts/check-openapi-types.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}

# syntax=docker/dockerfile:1
#
# Built only on the Linux build server/CI, inside the shared dev
# container (see docs/dev-container.md) — never on a developer laptop.

# Base images are build arguments so the Linux release/build environment can
# inject mirrored or digest-pinned references instead of relying on public
# registries in the build definition.
ARG UI_NODE_IMAGE=docker.io/library/node:22-alpine
ARG UI_GO_IMAGE=docker.io/library/golang:1.26
ARG UI_RUNTIME_IMAGE=alpine:3.24.1

# Frontend build stage: compiles the React/Vite SPA into dist/.
FROM ${UI_NODE_IMAGE} AS web-build
WORKDIR /src
COPY package.json package-lock.json ./
COPY tsconfig.json index.html ./
COPY scripts ./scripts
COPY src ./src
RUN npm ci
RUN npm run build

# Build stage: compiles a fully static binary with the same
# version/commit/build-time ldflags as `make build`. Builds from the
# vendored module tree (-mod=vendor), so this step needs no network
# access at all.
FROM ${UI_GO_IMAGE} AS build
WORKDIR /src
COPY . .
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
RUN GOWORK=off CGO_ENABLED=0 go build -mod=vendor \
    -ldflags "-X appliance-code/services/controlplane-ui/internal/version.Version=${VERSION} \
              -X appliance-code/services/controlplane-ui/internal/version.Commit=${COMMIT} \
              -X appliance-code/services/controlplane-ui/internal/version.BuildTime=${BUILD_TIME}" \
    -o /out/appliance-ui ./cmd/appliance-ui

# Final stage: small Alpine runtime with the static Go binary,
# compiled SPA bundle, CA bundle, tzdata, and entrypoint.
FROM ${UI_RUNTIME_IMAGE}
RUN set -eux; \
    apk add --no-cache bash ca-certificates tzdata; \
    addgroup -S -g 10002 appliance-ui; \
    adduser -S -D -H -u 10002 -G appliance-ui appliance-ui
COPY --from=build /out/appliance-ui /appliance-ui
COPY --from=web-build /src/bin/dist /opt/appliance-ui/dist
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh
USER 10002:10002
ENV APPLIANCE_UI_STATIC_DIR=/opt/appliance-ui/dist
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

ARG BASE_IMAGE=ghcr.io/project-zot/zot-linux-amd64:v2.1.8
# glibc runtime for the dynamically linked upstream binary (see FROM below).
ARG RUNTIME_BASE_IMAGE=debian:bookworm-slim
ARG RUNTIME_PACKAGES_INSTALLED=0

FROM ${BASE_IMAGE} AS upstream

# Wrapper keeps packaging consistent with other services/* images (make image /
# image-local + thin entrypoint). Primary operator logs still come from the
# artifact-server native file logger (config log.output → application.log on
# the mounted host path); this image does not tee stdout/stderr.
#
# Upstream implementation today is the pinned project-zot binary; the
# appliance name is artifact-server so we can swap implementations later.
#
# Final base must provide glibc (/lib64/ld-linux-x86-64.so.2). The upstream
# zot-linux-amd64 binary is dynamically linked; Alpine/musl cannot execute it
# (execve fails with "cannot execute: required file not found" / exit 127).
# CoreDNS and workflow-controller wrappers can stay on Alpine because those upstream binaries
# are statically linked.
#
# Bundle export prefetches RUNTIME_BASE_IMAGE into local storage and rebuilds
# with --pull-never (same as the upstream BASE_IMAGE prefetch).
# When RUNTIME_PACKAGES_INSTALLED=1 the base already has bash + ca-certificates
# (appliance-dependencies artifact-server-bases).
FROM ${RUNTIME_BASE_IMAGE}
ARG RUNTIME_PACKAGES_INSTALLED

RUN set -eux; \
    if [ "${RUNTIME_PACKAGES_INSTALLED}" != "1" ]; then \
      apt-get update \
        && apt-get install -y --no-install-recommends bash ca-certificates \
        && rm -rf /var/lib/apt/lists/*; \
    fi

# Published upstream image (stacker) places the binary here.
COPY --from=upstream /usr/local/bin/zot-linux-amd64 /usr/local/bin/artifact-server
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

RUN chmod 0755 /usr/local/bin/artifact-server /usr/local/bin/entrypoint.sh

# Matches appliance-registry chart podSecurityContext runAsUser/runAsGroup.
USER 10003:10003

# Chart args (serve /etc/artifact-server/config.json) are appended after the entrypoint.
# Config path /etc/artifact-server remains the chart mount for the current implementation.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# syntax=docker/dockerfile:1.7
ARG GO_IMAGE=docker.io/library/golang:1.26
ARG RUNTIME_IMAGE=alpine:3.24.1
ARG RUNTIME_PREBAKED=0
ARG BUILDPLATFORM
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG BUILD_VERSION=development
ARG TARGETARCH
WORKDIR /src
COPY go.mod ./
COPY . ./
RUN test -n "${TARGETARCH}" && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w -X main.buildVersion=${BUILD_VERSION}" -o /out/auth-service ./cmd/auth-service

FROM ${RUNTIME_IMAGE}
ARG RUNTIME_PREBAKED
RUN set -eux; if [ "${RUNTIME_PREBAKED}" != "1" ]; then apk add --no-cache ca-certificates tzdata; fi; addgroup -S -g 10016 auth-service; adduser -S -D -H -u 10016 -G auth-service auth-service
COPY --from=build /out/auth-service /auth-service
USER 10016:10016
EXPOSE 8080
ENTRYPOINT ["/auth-service"]

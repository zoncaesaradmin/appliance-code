{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "appliance-control-plane values",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "replicaCount",
    "image",
    "config",
    "secrets",
    "persistence",
    "service"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "service",
        "config",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "service": {
          "type": "object",
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "config": {
          "type": "object",
          "required": [
            "logLevel",
            "cookieSecure"
          ],
          "properties": {
            "logLevel": {
              "type": "string",
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ]
            },
            "cookieSecure": {
              "type": "boolean"
            },
            "controlPlaneBaseURL": {
              "type": "string"
            },
            "controlPlaneInternalBaseURL": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "actionRuntime": {
      "type": "object",
      "required": [
        "enabled",
        "service",
        "config",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "service": {
          "type": "object",
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
		"config": {
          "type": "object",
          "required": [
            "logLevel",
            "dataDir",
            "applicationLogPath"
          ],
          "properties": {
            "logLevel": {
              "type": "string",
              "enum": [
                "debug",
                "info",
                "warn",
                "error"
              ]
            },
            "dataDir": {
              "type": "string",
              "minLength": 1
            },
            "applicationLogPath": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "storageClassName": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "accessMode": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "namespace": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "applianceProfile",
        "canonicalOrigin",
        "logLevel"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabledCapabilities": {
                "type": "array",
                "contains": {"const": "artifact"}
              }
            },
            "required": ["enabledCapabilities"]
          },
          "then": {
            "required": ["artifactServerBaseURL"],
            "properties": {
              "artifactServerBaseURL": {
                "type": "string",
                "pattern": "^https?://[^/]+$"
              },
              "artifactServerAllowFake": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabledCapabilities": {
                "type": "array",
                "contains": {"const": "dns"}
              }
            },
            "required": ["enabledCapabilities"]
          },
          "then": {
            "required": ["dnsReadyURL"],
            "properties": {
              "dnsReadyURL": {
                "type": "string",
                "pattern": "^https?://[^\\s]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabledCapabilities": {
                "type": "array",
                "contains": {"const": "inference"}
              }
            },
            "required": ["enabledCapabilities"]
          },
          "then": {
            "required": ["inferenceGatewayBaseURL", "inferenceRuntimePackage", "inferenceEngine", "inferenceArchitecture"],
            "properties": {
              "inferenceGatewayBaseURL": {
                "type": "string",
                "pattern": "^https?://[^/]+$"
              },
              "inferenceRuntimePackage": {"type": "string", "minLength": 1},
              "inferenceEngine": {"enum": ["ollama", "vllm"]},
              "inferenceArchitecture": {"type": "string", "minLength": 1}
              }
            }
          }
      ],
      "properties": {
        "applianceProfile": {
          "type": "string",
          "minLength": 1
        },
        "applianceName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "nodeIPv4": {
          "type": "string"
        },
        "canonicalOrigin": {
          "type": "string",
          "minLength": 1
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "trustedProxyCount": {
          "type": "integer",
          "minimum": 0
        },
        "artifactServerBaseURL": {
          "type": "string"
        },
        "artifactServerAllowFake": {
          "type": "boolean"
        },
        "dnsReadyURL": {
          "type": "string"
        },
        "inferenceGatewayBaseURL": {
          "type": "string"
        },
        "inferenceRuntimePackage": {"type": "string"},
        "inferenceEngine": {"type": "string"},
        "inferenceArchitecture": {"type": "string"},
        "webUIHealthURL": {"type": "string"},
        "dnsZoneName": {
          "type": "string"
        },
        "dnsConfigMapNamespace": {
          "type": "string"
        },
        "dnsConfigMapName": {
          "type": "string"
        },
        "dnsBootstrapHostname": {
          "type": "string"
        },
        "dnsBootstrapIPv4": {
          "type": "string"
        },
        "dnsAllowFakeZoneSync": {
          "type": "boolean"
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": [
        "keysSecretName",
        "caSecretName"
      ],
      "properties": {
        "keysSecretName": {
          "type": "string",
          "minLength": 1
        },
        "caSecretName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": [
        "enabled",
        "accessMode",
        "size",
        "dataDir"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storageClassName": {
          "type": "string"
        },
        "accessMode": {
          "type": "string",
          "enum": [
            "ReadWriteOnce"
          ]
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "dataDir": {
          "type": "string",
          "minLength": 1
        },
        "metadataBundlesHostPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "publicPort",
        "internalPort"
      ],
      "properties": {
        "publicPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "internalPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "entryPoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host": {
          "type": "string"
        },
        "tlsSecretName": {
          "type": "string"
        },
        "tlsTermination": {
          "type": "string",
          "enum": [
            "traefik",
            "cloudflare"
          ],
          "default": "traefik"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "traefikNamespaceLabel": {
          "type": "object"
        },
        "registryNamespaceLabel": {
          "type": "object"
        },
        "registryPodLabels": {
          "type": "object"
        },
        "registryPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "dnsNamespaceLabel": {
          "type": "object"
        },
        "dnsPodLabels": {
          "type": "object"
        },
        "dnsReadyPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "blobStorage": {
      "type": "object",
      "required": ["endpoint", "bucket", "region", "credentialsSecretName", "image", "persistence"],
      "properties": {
        "endpoint": {"type": "string", "pattern": "^https?://[^/]+$"},
        "bucket": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "credentialsSecretName": {"type": "string", "minLength": 1},
        "image": {
          "type": "object",
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "digest": {"type": "string"},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "persistence": {
          "type": "object",
          "required": ["hostPath", "claimName", "size"],
          "properties": {
            "hostPath": {"type": "string", "pattern": "^/.+"},
            "claimName": {"type": "string", "minLength": 1},
            "size": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "videoLibrary": {
      "type": "object",
      "required": [
        "objectPrefix",
        "maxUploadBytes",
        "transferTimeout"
      ],
      "properties": {
        "objectPrefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/].*[^/]$"
        },
        "maxUploadBytes": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "transferTimeout": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {}
}

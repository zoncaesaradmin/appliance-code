{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["replicaCount", "image", "managerImage", "service", "persistence", "runtime", "engine", "gpu"],
  "properties": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "engine",
        "supportedModes",
        "cpuKVCacheSpaceGiB",
        "sharedMemorySize"
      ],
      "properties": {
        "mode": {
          "enum": ["auto", "cpu", "cuda"]
        },
        "engine": {
          "enum": ["ollama", "vllm"]
        },
        "supportedModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["cpu", "cuda"]}
        },
        "cpuKVCacheSpaceGiB": {
          "type": "integer",
          "minimum": 1
        },
        "sharedMemorySize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi)$"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceName", "servicePort", "cpuLimit", "cpuRequest", "sharedMemorySize"],
      "properties": {
        "serviceName": {"type": "string", "const": "inference-engine"},
        "servicePort": {"type": "integer", "minimum": 1},
        "maxMemory": {
          "type": "string",
          "description": "Optional absolute ceiling. Empty means host-derived budget only.",
          "pattern": "^$|^[1-9][0-9]*(Mi|Gi)$"
        },
        "cpuLimit": {"type": "string", "minLength": 1},
        "cpuRequest": {"type": "string", "minLength": 1},
        "sharedMemorySize": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "runtimeClassName", "visibleDevices", "driverCapabilities"],
      "properties": {
        "enabled": {"type": "boolean"},
        "runtimeClassName": {"type": "string", "minLength": 1},
        "visibleDevices": {"type": "string", "minLength": 1},
        "driverCapabilities": {"type": "string", "minLength": 1}
      }
    },
    "replicaCount": {"type": "integer", "const": 1},
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      },
      "anyOf": [
        {
          "properties": {
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          },
          "required": ["digest"]
        },
        {
          "properties": {
            "tag": {"type": "string", "minLength": 1}
          },
          "required": ["tag"]
        }
      ]
    },
    "managerImage": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      },
      "anyOf": [
        {
          "properties": {
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          },
          "required": ["digest"]
        },
        {
          "properties": {
            "tag": {"type": "string", "minLength": 1}
          },
          "required": ["tag"]
        }
      ]
    },
    "service": {
      "type": "object",
      "required": ["port", "targetPort"],
      "properties": {
        "port": {"type": "integer", "const": 8080},
        "targetPort": {"type": "integer", "const": 11434}
      }
    },
    "persistence": {
      "type": "object",
      "required": ["claimName", "accessMode", "size"],
      "properties": {
        "hostPath": {
          "description": "When enabled, chart emits a static hostPath PersistentVolume + PVC so Restricted PSA pods mount a PVC while models remain on the host for models-import. Not a pod-level hostPath volume.",
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "path": {"type": "string", "minLength": 1}
          }
        },
        "claimName": {"type": "string", "const": "models"},
        "storageClassName": {"type": "string"},
        "accessMode": {"const": "ReadWriteOnce"},
        "size": {"type": "string", "minLength": 1}
      }
    },
    "namespace": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "const": "inference"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "allowDNSToKubeSystem": {"type": "boolean"},
        "allowModelDownloadHTTPS": {"type": "boolean"}
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsUser": {"type": "integer", "const": 10006},
        "runAsGroup": {"type": "integer", "const": 10006},
        "fsGroup": {"type": "integer", "const": 20000}
      }
    }
  }
}
